
@baseUrl = http://localhost:5000/auth

### Register admin
POST {{baseUrl}}/signup
Content-Type: application/json

{
  "fullName": "My Admin",
  "email": "admin@mail.com",
  "password": "mypass",
  "role": "ROLE_ADMIN"
}

### Login as admin
# @name loginAdmin
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "admin@mail.com",
  "password": "mypass"
}

> {%
    client.global.set("token", response.body.jwt);
%}

### Register employer
POST {{baseUrl}}/signup
Content-Type: application/json

{
  "fullName": "My Name",
  "email": "my@mail.com",
  "password": "mypass",
  "role": "ROLE_EMPLOYER"
}

### Login as employer
# @name loginEmployer
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "my@mail.com",
  "password": "mypass"
}

> {%
    client.global.set("token", response.body.jwt);
    client.log("JWT saved: " + (client.global.get("token") ? "YES" : "NO"));
%}
