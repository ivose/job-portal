
import auth.rest

@baseUrl = http://localhost:5000
@companyId = 1

### 0. Login as employer and save JWT
run #loginEmployer

### 1. Create a new company
POST {{baseUrl}}/api/company
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Tech Solutions Estonia",
  "tagline": "Building better software",
  "description": "Software development and IT consulting company",
  "logoUrl": "https://example.com/logo.png",
  "coverImageUrl": "https://example.com/cover.png",
  "website": "https://techsolutions.example.com",
  "email": "contact@techsolutions.example.com",
  "phone": "+3725550123",
  "foundedYear": 2020,
  "companySize": "SMALL",
  "companyType": "PRIVATE",
  "industryType": "TELECOMMUNICATIONS",
  "registrationNumber": "REG-EST-12345",
  "socialLinks": [
    {
      "platform": "LINKEDIN",
      "url": "https://www.linkedin.com/company/techsolutions"
    },
    {
      "platform": "GITHUB",
      "url": "https://github.com/techsolutions"
    }
  ]
}

### 2. Get my company
GET {{baseUrl}}/api/company/my
Authorization: Bearer {{token}}

### 3. Get company by ID
GET {{baseUrl}}/api/company/{{companyId}}
Authorization: Bearer {{token}}

### 4. List all companies
GET {{baseUrl}}/api/company
Authorization: Bearer {{token}}

### 5. Filter companies
# GET {{baseUrl}}/api/company?companyType=YOUR_COMPANY_TYPE&industryType=YOUR_INDUSTRY_TYPE&companyStatus=ACTIVE

### 6. Update company
PUT {{baseUrl}}/api/company/{{companyId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Tech Solutions Estonia Updated",
  "tagline": "Software that scales",
  "description": "Updated software development and consulting company",
  "logoUrl": "https://example.com/new-logo.png",
  "coverImageUrl": "https://example.com/new-cover.png",
  "website": "https://techsolutions.example.com",
  "email": "hello@techsolutions.example.com",
  "phone": "+3725512345",
  "foundedYear": 2020,
  "registrationNumber": "REG-EST-12345",
  "companySize": "SMALL",
  "companyType": "PRIVATE",
  "industryType": "TELECOMMUNICATIONS",
  "socialLinks": [
    {
      "platform": "LINKEDIN",
      "url": "https://www.linkedin.com/company/techsolutions"
    },
    {
      "platform": "WEBSITE",
      "url": "https://techsolutions.example.com"
    }
  ]
}

### 7. Verify company (use admin JWT)
PATCH {{baseUrl}}/api/company/verify
Authorization: Bearer {{token}}

### 8. Deactivate my company
PATCH {{baseUrl}}/api/company/deactivate
Authorization: Bearer {{token}}

### 9. Delete company (run last)
DELETE {{baseUrl}}/api/company/{{companyId}}
Authorization: Bearer {{token}}
