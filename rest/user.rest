
import auth.rest

@baseUrl = http://localhost:5000

### Login as admin and save JWT
run #loginAdmin

### Get my profile
GET {{baseUrl}}/api/users/profile
Authorization: Bearer {{token}}

### Update my profile
PUT {{baseUrl}}/api/users/profile
Authorization: Bearer {{token}}
Content-Type: application/json

